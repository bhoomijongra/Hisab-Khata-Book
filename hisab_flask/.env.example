SECRET_KEY=change-this-to-a-random-string

# Local development (used if DATABASE_URL is not set)
DB_NAME=hisab_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# In production (Railway), set DATABASE_URL instead and the DB_* vars are ignored
# DATABASE_URL=mysql://user:password@host:port/dbname

EMAIL_HOST_USER=your_brevo_smtp_login
EMAIL_HOST_PASSWORD=your_brevo_master_key
DEFAULT_FROM_EMAIL=your_verified_sender_email

CORS_ORIGINS=http://localhost:5173
